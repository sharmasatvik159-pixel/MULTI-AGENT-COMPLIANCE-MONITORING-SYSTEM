# ==============================================================================
# MERIDIAN GLOBAL BANK - MULTI-AGENT COMPLIANCE MONITORING SYSTEM (PROJECT 1B)
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# SYSTEM IDENTITY & ENVIRONMENT
SYSTEM_ENV=production
APP_NAME=meridian-compliance-agent-system
PROJECT_CODE=1B
NODE_ID=meridian-node-mum-01
AWS_REGION=ap-south-1

# JURISDICTION & DATA SOVEREIGNTY
PRIMARY_DATA_CENTER=mumbai-dc1
SECONDARY_DATA_CENTER=hyderabad-dc2
RBI_DATA_LOCALIZATION_ENFORCED=true
GDPR_RESTRICTIONS_ENFORCED=true

# MESSAGE BROKER - APACHE KAFKA (HIGH THROUGHPUT STREAMING)
KAFKA_BOOTSTRAP_SERVERS=kafka-01.internal.meridian.bank:9092,kafka-02.internal.meridian.bank:9092,kafka-03.internal.meridian.bank:9092
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/meridian-ca.pem
KAFKA_SSL_CERT_LOCATION=/etc/ssl/certs/agent-client.cert.pem
KAFKA_SSL_KEY_LOCATION=/etc/ssl/private/agent-client.key.pem
KAFKA_TRANSACTIONS_TOPIC=meridian.transactions.v1
KAFKA_COMMUNICATIONS_TOPIC=meridian.communications.v1
KAFKA_ALERTS_TOPIC=meridian.compliance.alerts.v1
KAFKA_AUDIT_LOG_TOPIC=meridian.compliance.audit.v1
KAFKA_CONSUMER_GROUP=meridian-compliance-group

# MESSAGE BROKER - RABBITMQ (PRIORITY QUEUES, RPC & DLQ)
RABBITMQ_HOST=rabbitmq.internal.meridian.bank
RABBITMQ_PORT=5671
RABBITMQ_USER=agent_coordinator
RABBITMQ_PASSWORD=ReplaceWithSecurePassword_VaultManaged!
RABBITMQ_VHOST=/meridian-compliance
RABBITMQ_USE_SSL=true
RABBITMQ_PRIORITY_QUEUE=agent.escalation.priority
RABBITMQ_DLQ_QUEUE=agent.deadletter.queue

# RELATIONAL DATABASE - POSTGRESQL & TIMESCALEDB
POSTGRES_HOST=postgres-cluster.internal.meridian.bank
POSTGRES_PORT=5432
POSTGRES_DB=meridian_compliance_db
POSTGRES_USER=compliance_admin
POSTGRES_PASSWORD=ReplaceWithSecureDbPassword_VaultManaged!
POSTGRES_SSL_MODE=verify-full
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_MIN_CONNECTIONS=20

# VECTOR DATABASE - CHROMADB
CHROMA_SERVER_HOST=chroma.internal.meridian.bank
CHROMA_SERVER_HTTP_PORT=8000
CHROMA_AUTH_PROVIDER=token
CHROMA_AUTH_CREDENTIALS=ReplaceWithSecureChromaToken!
CHROMA_COLLECTION_REGULATIONS=global_regulations_v1
CHROMA_COLLECTION_LEXICONS=compliance_lexicons_v1

# WORKFLOW ORCHESTRATION - TEMPORAL.IO
TEMPORAL_HOST=temporal.internal.meridian.bank:7233
TEMPORAL_NAMESPACE=meridian-compliance-workflows
TEMPORAL_TLS_CERT_PATH=/etc/temporal/certs/client.pem
TEMPORAL_TLS_KEY_PATH=/etc/temporal/certs/client-key.pem

# IN-MEMORY CACHE & DEDUPLICATION - REDIS
REDIS_HOST=redis.internal.meridian.bank
REDIS_PORT=6379
REDIS_PASSWORD=ReplaceWithSecureRedisPassword!
REDIS_SSL=true
REDIS_IDEMPOTENCY_TTL_SECONDS=86400

# LLM & EMBEDDING PROVIDERS (FOR NLP, REASONING & EXTRACTION)
ANTHROPIC_API_KEY=sk-ant-api-prod-ReplaceWithKey
OPENAI_API_KEY=sk-proj-prod-ReplaceWithKey
LOCAL_LLM_BASE_URL=https://vllm-cluster.internal.meridian.bank/v1
LOCAL_LLM_MODEL=meta-llama/Llama-3-70b-Instruct
EMBEDDING_MODEL=text-embedding-3-large

# CRYPTOGRAPHIC SECURITY & AUDIT CHAIN
LEDGER_HMAC_SECRET_KEY=ReplaceWithHighEntropyHMACSecretVaultManaged
VAULT_ADDR=https://vault.internal.meridian.bank:8200
VAULT_ROLE_ID=meridian-compliance-agent-role
VAULT_SECRET_ID=ReplaceWithVaultSecretId

# LOGGING & OBSERVABILITY
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGGING=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal.meridian.bank:4317
PROMETHEUS_METRICS_PORT=9090
